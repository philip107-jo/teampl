generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  LEADER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  KICKED
  LEFT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  low
  medium
  high
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String
  name             String
  studentId        String?
  department       String?
  createdAt        DateTime @default(now())
  
  msAccountId      String?  @unique
  msRefreshToken   String?
  isUnivVerified   Boolean  @default(false)
  
  projectMembers ProjectMember[]
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  course      String?
  description String?
  progress    Int      @default(0)
  deadline    String
  members     Int      @default(1)
  color       String?  @default("purple")
  icon        String?  @default("Database")
  inviteCode  String?  @unique
  createdAt   DateTime @default(now())

  projectMembers ProjectMember[]
  tasks           Task[]
  schedules       Schedule[]
  sharedDocuments SharedDocument[]
}

model ProjectMember {
  id        Int          @id @default(autoincrement())
  userEmail String
  projectId Int
  role      ProjectRole  @default(MEMBER)
  status    MemberStatus @default(ACTIVE)
  kickReason String?
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userEmail, projectId])
}

model Task {
  id          String   @id @default(uuid())
  projectId   Int
  title       String
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(medium)
  difficulty  Int          @default(3)
  deadline    String
  ownerEmail  String?
  assignees   String[]
  completedAt DateTime?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Schedule {
  id         Int     @id @default(autoincrement())
  projectId  Int
  title      String
  date       String
  endDate    String?
  type       String  @default("other")
  color      String  @default("bg-gray-500")
  dot        String  @default("bg-gray-500")
  ownerEmail String?

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectDeleteAlert {
  id            Int      @id @default(autoincrement())
  userEmail     String
  projectName   String
  deleteReason  String
  createdAt     DateTime @default(now())
}

model SharedDocument {
  id          Int      @id @default(autoincrement())
  projectId   Int
  fileName    String
  fileType    String   // 'word', 'excel', 'ppt'
  webUrl      String   // MS Graph webUrl
  creatorEmail String
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
