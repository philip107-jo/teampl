generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  LEADER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  KICKED
  LEFT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  low
  medium
  high
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String
  studentId  String?
  department String?
  createdAt  DateTime @default(now())
  
  projectMembers ProjectMember[]
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  course      String?
  description String?
  progress    Int      @default(0)
  deadline    String
  members     Int      @default(1)
  color       String?  @default("purple")
  icon        String?  @default("Database")
  inviteCode  String?  @unique
  createdAt   DateTime @default(now())

  projectMembers ProjectMember[]
}

model ProjectMember {
  id        Int          @id @default(autoincrement())
  userEmail String
  projectId Int
  role      ProjectRole  @default(MEMBER)
  status    MemberStatus @default(ACTIVE)
  kickReason String?
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userEmail, projectId])
}

model Task {
  id          String   @id @default(uuid())
  workspaceId String?
  title       String
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(medium)
  deadline    String
  ownerEmail  String?
  assignees   String[] // We can use string array to match current frontend array
  createdAt   DateTime @default(now())
}

model Schedule {
  id      Int     @id @default(autoincrement())
  title   String
  project String?
  date    String
  endDate    String?
  type       String  @default("other")
  color      String  @default("bg-gray-500")
  dot        String  @default("bg-gray-500")
  ownerEmail String?
}
